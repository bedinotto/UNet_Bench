@INPROCEEDINGS{Jerbi2024,
  author={Jerbi, Olfa and Lee, Sukhan},
  booktitle={2024 18th International Conference on Ubiquitous Information Management and Communication (IMCOM)}, 
  title={Thermal Imaging Body Temperature Estimation Independent of Environmental Conditions and Individual Variations}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Body temperature represents one of most informative and frequently measured vital signs. In particular, contactless yet accurate body temperature measurement solutions are necessary for dealing with infectious diseases as well as patients with a low immunity, for which thermal imaging has been the most convenient choice. However, thermal imaging body temperature measurement needs to address the dependency of its accuracy on environmental conditions and individual differences. Although conventional thermal imaging body temperature measurements rely on ROIs that are less susceptible to environmental conditions, they are still limited in offering a medical grade accuracy under environmental variations. In this study, we propose a method for an accurate thermal imaging body temperature measurement independently of environmental conditions as well as individual differences. We achieve higher accuracy with this independence by identifying the correlation between environmental conditions and the temperature distributions on facial ROIs and clustering the correlation patterns according to individual types. For implementation, we selected 3 facial skin ROIs (Eye, Nose and Cheek) such that their distribution is concatenated with the classification results on environmental conditions and individual types to obtain a body temperature. We achieved an RMSE error below the medically required 0.2°C threshold regardless of environmental and individual settings.},
  keywords={Temperature measurement;Temperature distribution;Correlation;Thermal management;Skin;Immune system;Biomedical imaging;Thermal Imaging;Body Temperature Estimation;Individual Differences;Machine Learning;Environmental Conditions},
  doi={10.1109/IMCOM60618.2024.10418301},
  ISSN={},
  month={Jan},
}


@article{Ioannou2014,
author = {Ioannou, Stephanos and Gallese, Vittorio and Merla, Arcangelo},
title = {Thermal infrared imaging in psychophysiology: Potentialities and limits},
journal = {Psychophysiology},
volume = {51},
number = {10},
pages = {951-963},
keywords = {Arousal, Autonomic nervous system, Emotions, Psychophysiology, Thermal infrared imaging},
doi = {https://doi.org/10.1111/psyp.12243},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/psyp.12243},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1111/psyp.12243},
abstract = {Abstract Functional infrared thermal imaging (fITI) is considered an upcoming, promising methodology in the emotional arena. Driven by sympathetic nerves, observations of affective nature derive from muscular activity subcutaneous blood flow as well as perspiration patterns in specific body parts. A review of 23 experimental procedures that employed fITI for investigations of affective nature is provided, along with the adopted experimental protocol and the thermal changes that took place on selected regions of interest in human and nonhuman subjects. Discussion is provided regarding the selection of an appropriate baseline, the autonomic nature of the thermal print, the experimental setup, methodological issues, limitations, and considerations, as well as future directions.},
year = {2014}
}

